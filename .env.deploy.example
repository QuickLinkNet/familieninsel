# Kopieren nach ".env.deploy".
# .env.deploy wird nicht versioniert.

FTP_HOST=web17.alfahosting-server.de
FTP_USER=web1738
FTP_PASSWORD=
FTP_PORT=21

# true für FTPS, false für unverschlüsseltes FTP. FTPS scheitert bei manchen
# Routern/Firewalls (FTP-ALG kann die PASV-Antwort nicht mehr lesen, wenn sie
# verschlüsselt ist -> "425 Unable to build data connection"). Auf false
# stellen, wenn FTPS zuverlässig mit diesem Fehler fehlschlägt.
FTP_SECURE=false

# Das Deploy-Skript darf ausschließlich innerhalb dieses Ordners arbeiten.
REMOTE_BASE_DIR=/html/apps/familieninsel

# Öffentliche URL der Anwendung.
PUBLIC_APP_URL=https://www.red-it.org/apps/familieninsel/

# Vite Base Path.
APP_BASE_PATH=/apps/familieninsel/

# Öffentliche API-Basis.
API_BASE_PATH=/apps/familieninsel/api/
